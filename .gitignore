# ============================================================================
# Кластеризация МО России v2.0 — что НЕ коммитить
# ============================================================================
# Принцип: код и документы в репозиторий, данные и тяжёлые артефакты — нет.
# Тяжёлое (parquet, pt, zip) идёт через Kaggle Dataset
# `cluster-mo-russia-v2-artifacts`.
# ============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Виртуальные окружения ---
venv/
ENV/
env/
.venv/
.python-version

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/

# --- Данные (НЕ коммитить в Git) ---
# XLSX Росстата и parquet СберИндекса идут через Kaggle Dataset
*.xlsx
*.xls
*.csv
*.tsv

# --- Parquet и тяжёлые форматы (идут через Kaggle Dataset) ---
*.parquet
*.feather
*.h5
*.hdf5
*.orc
*.avro

# --- Модели и чекпойнты (идут через Kaggle Dataset) ---
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.pkl
*.pickle
*.joblib
*.npy
*.npz

# --- Архивы (ZIP-снапшоты идут через Kaggle Dataset) ---
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# --- Служебный кэш пайплайна ---
_xcache/
processed/_xcache/

# --- Промежуточные артефакты вне processed/ ---
kaggle_out_probe/
tmp/
temp/
.cache/
.cache_*/

# --- Matplotlib / plotly ---
*.png
*.jpg
*.jpeg
*.pdf
*.svg
*.eps
*.html
*.json

# --- Исключения: что ВСЁ-ТАКИ коммитим ---
# Документы, конфиг, отчёты — они не тяжёлые
!README.md
!LICENSE
!requirements.txt
!configs/*.json
!docs/*.md
!reports/*.md
!reports/*.json

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Логи ---
*.log
logs/

# --- Kaggle specifics ---
/kaggle/working/
kaggle.json
.kaggle/

# --- Бэкапы и временные файлы ---
*.bak
*.tmp
*.orig
*.rej
*~